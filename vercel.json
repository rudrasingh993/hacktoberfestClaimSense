{
  "framework": null,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,config/**,data/**,frontend/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
